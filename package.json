{
  "name": "digitalus.github.io",
  "version": "1.0.0",
  "description": "Personal website for Digitalus the developer…",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./css/tailwind.input.css -o ./css/tailwind.css --minify",
    "build:js": "terser src/apps/calc/script.js -c -m -o apps/calc/script.js && terser src/apps/frogger/script.js -c -m -o apps/frogger/script.js",
    "watch:css": "tailwindcss -i ./css/tailwind.input.css -o ./css/tailwind.css --watch"
  },
